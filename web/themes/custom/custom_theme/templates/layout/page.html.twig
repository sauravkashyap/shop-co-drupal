{# Main Layout Template #}
<div class="layout-container">

  {# Render the Top Header region (contains the dynamic Announcement Bar) #}
  {% if page.top_header %}
    <div class="region-top-header">
      {{ page.top_header }}
    </div>
  {% endif %}

  <header class="site-header">
    <div class="site-header__inner">
      {{ page.header }}
    </div>
  </header>

  <main role="main">
    <div class="container admin-controls">
      {{ page.breadcrumb }}
      {{ page.highlighted }}
      {{ page.help }}
      {{ page.messages }}
      {{ page.tabs }}
    </div>

    {{ page.content }}
    {% if page.newsletter %}
      <div class="newsletter-region">
        {{ page.newsletter }}
      </div>
    {% endif %}
  </main>

  {% include directory ~ '/templates/layout/footer.html.twig' %}

</div>
